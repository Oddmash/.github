#!/bin/sh
# Run supported GitHub CLI and Git commands as the Oddmash AI account.
set +x
set -eu

export GH_HOST=github.com LC_ALL=C GIT_TRACE_REDACT=1
unset GH_DEBUG GIT_TRACE GIT_TRACE_CURL GIT_CURL_VERBOSE GIT_TRACE_PACKET GIT_TRACE2 GIT_TRACE2_EVENT GIT_TRACE2_PERF
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GH_REPO GIT_CONFIG

launcher_directory=$(cd "$(dirname "$0")" && pwd -P)
ODDMASH_AI_KEYCHAIN="$launcher_directory/oddmash-ai-keychain.sh"
export ODDMASH_AI_KEYCHAIN
. "$ODDMASH_AI_KEYCHAIN"

check_repository_path() {
  case "$1" in
    *[!a-zA-Z0-9_./-]*|*/*/*) return 1 ;;
  esac
  printf '%s\n' "$1" | grep -Eq '^[a-zA-Z0-9][a-zA-Z0-9-]*/[a-zA-Z0-9_.-]+$'
}

check_gh_options() {
  gh_subcommand=$1
  shift
  explicit_head=false
  has_title=false has_body=false
  while [ "$#" -gt 0 ]; do
    case "$gh_subcommand:$1" in
      pr:--draft|pr:--no-maintainer-edit) shift; continue ;;
      pr:-H|pr:--head)
        case "${2:-}" in
          ''|-*) fail 'Provide an explicit pull request head branch.' ;;
        esac
        explicit_head=true
        ;;
      issue:-t|issue:--title|pr:-t|pr:--title)
        [ -n "${2:-}" ] || fail 'Provide a nonempty title before authenticating.'
        has_title=true
        ;;
      issue:-b|issue:--body|issue:-F|issue:--body-file|pr:-b|pr:--body|pr:-F|pr:--body-file)
        [ -n "${2:-}" ] || fail 'Provide a body or body file before authenticating.'
        has_body=true
        ;;
      issue:-l|issue:--label|issue:-a|issue:--assignee) ;;
      pr:-B|pr:--base|pr:-l|pr:--label|pr:-a|pr:--assignee|pr:-r|pr:--reviewer) ;;
      *) fail 'Unsupported GitHub CLI option. Use the documented options with separate values.' ;;
    esac
    [ "$#" -ge 2 ] || fail 'A GitHub CLI option is missing its value.'
    shift 2
  done
  [ "$has_title" = true ] && [ "$has_body" = true ] ||
    fail 'Provide a title and body or body file before authenticating.'
  if [ "$gh_subcommand" = pr ] && [ "$explicit_head" = false ]; then
    fail 'Push the branch separately and provide --head when creating a PR.'
  fi
}

check_commit_options() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -m|--message|-F|--file|--trailer)
        [ "$#" -ge 2 ] || fail 'A Git commit option is missing its value.'
        shift
        ;;
      --message=*|--file=*|--trailer=*|-a|--all|-s|--signoff) ;;
      --) break ;;
      *) fail 'Use a new Git commit with an explicit message. Author overrides and history reuse are unsupported.' ;;
    esac
    shift
  done

  for state in CHERRY_PICK_HEAD rebase-merge rebase-apply; do
    state_path=$(git rev-parse --git-path "$state") || fail 'Run Git commit from its checkout.'
    [ ! -e "$state_path" ] || fail 'Complete history operations without the AI commit launcher.'
  done
}

check_push_remote() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run|-u|--set-upstream) shift ;;
      *) break ;;
    esac
  done
  [ "$#" -ge 2 ] || fail 'Provide a named Git remote and an explicit refspec.'
  push_remote=$1
  shift
  case "$push_remote" in
    -*|*[!a-zA-Z0-9._-]*) fail 'Provide a named Git remote.' ;;
  esac
  for refspec do
    case "$refspec" in
      -*|'') fail 'Put supported Git push options before the remote.' ;;
    esac
  done
  push_url=$(git remote get-url --push --all -- "$push_remote" 2>/dev/null) ||
    fail 'Cannot determine the effective Git push destination.'
  case "$push_url" in
    https://github.com/*) ;;
    *) fail 'Git push requires credential-free github.com HTTPS.' ;;
  esac
  check_repository_path "${push_url#https://github.com/}" ||
    fail 'Git push requires one credential-free github.com HTTPS destination.'
}

case "${1:-}" in
  gh)
    shift
    case "${1:-}" in
      api)
        [ "$#" -eq 4 ] && [ "$2" = user ] && [ "$3" = --jq ] && [ "$4" = .login ] ||
          fail 'Use gh api user --jq .login to verify the launcher account.'
        load_github_credential
        printf '%s\n' arvynoo
        ;;
      issue|pr)
        [ "$#" -ge 4 ] && [ "$2" = create ] && [ "$3" = --repo ] ||
          fail 'Use issue create or pr create with --repo OWNER/REPO first.'
        kind=$1 repository=$4
        check_repository_path "$repository" || fail 'Use --repo OWNER/REPO on github.com.'
        shift 4
        check_gh_options "$kind" "$@"
        export GH_PROMPT_DISABLED=1 GH_PAGER=cat
        load_github_credential
        exec gh "$kind" create --repo "github.com/$repository" "$@"
        ;;
      *) fail 'Verify the GitHub account or create an issue or pull request.' ;;
    esac
    ;;
  git)
    shift
    case "${1:-}" in
      push)
        if [ -z "${HOME:-}" ] || [ -n "${NETRC:-}" ] ||
          [ -e "$HOME/.netrc" ] || [ -L "$HOME/.netrc" ] ||
          [ -e "$HOME/_netrc" ] || [ -L "$HOME/_netrc" ]; then
          fail 'Use a session without netrc credentials for authenticated Git operations.'
        fi
        status=0
        git config --name-only --get-regexp '^http(\..*)?\.extraheader$' >/dev/null 2>&1 || status=$?
        [ "$status" -eq 1 ] || fail 'Use a checkout with no Git HTTP extra headers for authenticated operations.'
        shift
        check_push_remote "$@"
        set -- push "$@"
        [ -z "${GIT_SSL_NO_VERIFY+x}" ] || fail 'Git push requires TLS certificate verification. Unset GIT_SSL_NO_VERIFY.'
        status=0
        tls_verify=$(git config --type=bool --get-urlmatch http.sslVerify "$push_url" 2>/dev/null) || status=$?
        case "$status:$tls_verify" in
          0:true|1:) ;;
          *) fail 'Git push requires TLS certificate verification for the destination.' ;;
        esac
        export GIT_ALLOW_PROTOCOL=https
        redirect_override="http.$push_url.followRedirects=false"
        redirects=$(git -c "$redirect_override" config --type=bool --get-urlmatch http.followRedirects "$push_url") ||
          fail 'Cannot verify Git HTTP redirect settings.'
        [ "$redirects" = false ] || fail 'Git push requires HTTP redirects to be disabled.'
        set -- -c "$redirect_override" "$@"
        ;;
      commit)
        shift
        check_commit_options "$@"
        export GIT_AUTHOR_NAME=arvynoo GIT_COMMITTER_NAME=arvynoo
        export GIT_AUTHOR_EMAIL=264418006+arvynoo@users.noreply.github.com
        export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
        exec git commit "$@"
        ;;
      *) fail 'Use an explicit Git push or commit command.' ;;
    esac
    export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=false
    exec git -c credential.helper= \
      -c 'credential.https://github.com.helper=!f() { [ "$1" = get ] || return 0; set +x; . "$ODDMASH_AI_KEYCHAIN"; git_github_credential; }; f' \
      -c credential.https://github.com.username=arvynoo \
      -c http.followRedirects=false -c push.recurseSubmodules=no "$@"
    ;;
  *) printf '%s\n' 'Usage: oddmash-ai gh|git <arguments>' >&2; exit 2 ;;
esac
